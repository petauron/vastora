{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vastora.example/schema/catalog-2.json",
  "title": "Vastora catalog payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "apps"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "apps": {
      "type": "array",
      "items": { "$ref": "app-manifest.schema.json" }
    }
  }
}
