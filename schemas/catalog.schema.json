{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vastora.petauron.com/contracts/catalog/v0.1/catalog.schema.json",
  "title": "Vastora v0.1 catalog payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "apps"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "apps": {
      "type": "array",
      "items": { "$ref": "app-manifest.schema.json" }
    }
  }
}
