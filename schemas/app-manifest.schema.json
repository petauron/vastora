{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vastora.petauron.com/contracts/catalog/v0.1/app-manifest.schema.json",
  "title": "Vastora v0.1 typed-executor app manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "description", "license", "config"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "name": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "license": { "type": "string", "pattern": "\\S" },
    "images": { "type": "array", "items": { "$ref": "#/$defs/image" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
    "homepage": { "$ref": "#/$defs/homepage" },
    "hostAccess": { "type": "boolean" },
    "config": { "type": "array", "items": { "$ref": "#/$defs/configField" } }
  },
  "anyOf": [
    { "required": ["images"], "properties": { "images": { "type": "array", "minItems": 1 } } },
    { "required": ["artifacts"], "properties": { "artifacts": { "type": "array", "minItems": 1 } } }
  ],
  "$defs": {
    "portableInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-CN"],
      "properties": {
        "en": { "type": "string", "pattern": "\\S" },
        "zh-CN": { "type": "string", "pattern": "\\S" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reference"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "reference": {
          "type": "string",
          "pattern": "^(?:(?:[a-z0-9]|[a-z0-9][a-z0-9-]*[a-z0-9])(?:\\.(?:[a-z0-9]|[a-z0-9][a-z0-9-]*[a-z0-9]))*(?::[0-9]+)?/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operatingSystem", "architecture", "url", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "operatingSystem": { "const": "linux" },
        "architecture": { "enum": ["amd64", "arm64"] },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "protocol", "containerPort"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "protocol": { "enum": ["http", "https"] },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "defaultHostPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "hostPortField": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "healthPath": { "type": "string", "pattern": "^/(?!/)[^?#]*$" },
        "management": { "type": "boolean" }
      },
      "oneOf": [
        { "required": ["defaultHostPort"], "not": { "required": ["hostPortField"] } },
        { "required": ["hostPortField"], "not": { "required": ["defaultHostPort"] } }
      ]
    },
    "homepage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "path"],
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "path": { "type": "string", "pattern": "^/(?!/)[^?#]*$" }
      }
    },
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "label", "description", "required", "secret"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "type": { "enum": ["string", "boolean", "integer"] },
        "label": { "$ref": "#/$defs/localized" },
        "description": { "$ref": "#/$defs/localized" },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" },
        "default": {
          "anyOf": [
            { "type": "string" },
            { "type": "boolean" },
            { "$ref": "#/$defs/portableInteger" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "secret": { "const": true } }, "required": ["secret"] },
          "then": { "not": { "required": ["default"] } }
        },
        {
          "if": { "properties": { "type": { "const": "string" } }, "required": ["type"] },
          "then": { "properties": { "default": { "type": "string" } } }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } }, "required": ["type"] },
          "then": { "properties": { "default": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "type": { "const": "integer" } }, "required": ["type"] },
          "then": { "properties": { "default": { "$ref": "#/$defs/portableInteger" } } }
        }
      ]
    }
  }
}
