FROM --platform=$BUILDPLATFORM golang:1.26.6-bookworm AS go-build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN GOTOOLCHAIN=go1.26.6 go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOTOOLCHAIN=go1.26.6 go build -trimpath -ldflags="-s -w" -o /out/vastora ./cmd/vastora
RUN mkdir /out/agent-data && chown 65532:65532 /out/agent-data

FROM gcr.io/distroless/static-debian13
COPY --from=go-build /out/vastora /usr/local/bin/vastora
COPY --from=go-build --chown=65532:65532 /out/agent-data /var/lib/vastora-agent
VOLUME ["/var/lib/vastora-agent"]
ENTRYPOINT ["/usr/local/bin/vastora"]
