          "defaultHostPort": 18080,
          "healthPath": "/healthz",
          "management": true
        }
      ],
      "homepage": {
        "service": "dashboard",
        "path": "/"
      },
      "config": [
        {
          "key": "public_url",
          "type": "string",
          "label": {
            "en": "Dashboard HTTPS origin",
            "zh-CN": "面板 HTTPS 地址"
          },
          "description": {
            "en": "The exact HTTPS origin used in your browser, such as https://pulse.example.com. No subpath. It must match the access entry before signing in; it is separate from the collector's private URL.",
            "zh-CN": "浏览器实际访问的 HTTPS 地址，例如 https://pulse.example.com，不含子路径。登录前需配置匹配的访问入口；它与探针私网地址分别管理。"
          },
          "required": true,
          "secret": false
        },
        {
          "key": "setup_token",
          "type": "string",
          "label": {
            "en": "Administrator setup token",
            "zh-CN": "管理员初始化令牌"
          },
          "description": {
            "en": "Supply a private random token of 32–4096 bytes and retain it for the first /login setup. Stored encrypted and written only to a private container file, never an environment variable. Omit on later upgrades to retain it.",
            "zh-CN": "提供 32–4096 字节的私密随机令牌并妥善保存，首次访问 /login 时使用。加密保存，仅写入容器私密文件，不进入环境变量。后续升级留空保留原令牌。"
          },
          "required": true,
          "secret": true
        }
      ],
      "packageRevision": 1,
      "runtime": {
        "kind": "docker",
        "version": 1,
        "storage": [
          {
            "name": "data",
            "persistent": true
          }
        ],
        "docker": {
          "containers": [
            {
              "name": "pulse",
              "image": "pulse",
              "user": "65532:65532",
              "credentials": {
                "setup-token": "setup_token"
              },
              "environment": {
                "PULSE_PUBLIC_URL": {
                  "config": "public_url"
                },
                "PULSE_SETUP_TOKEN_FILE": {
                  "runtime": {
                    "kind": "credential-file",
                    "name": "setup-token"
                  }
                }
              },
              "mounts": [
                {
                  "storage": "data",
                  "target": "/var/lib/pulse"
                }
              ],
              "ports": [
                {
                  "service": "dashboard"
                }
              ],
              "health": {
                "service": "dashboard",
                "path": "/healthz",
                "timeoutSeconds": 30
              }
            }
          ]
        }
      }
